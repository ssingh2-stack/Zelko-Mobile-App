{
  "expo": {
    "name": "Clipd",
    "slug": "clipd-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "clipd",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C1810"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.getclipd.app",
      "infoPlist": {
        "CFBundleDisplayName": "Clipd",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "ca.getclipd.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.ca.getclipd.app",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "googlePlacesKey": "AIzaSyCoqU_MEKty87QSJC8ES_yd-TodMlRdRSQ",
      "stripePublishableKey": "pk_test_51TEerz1BRIdhub0G0wQ8cCnfQEQ2nOnyUHShHeOXux8yMgccucWBTCKnLnb8Pq1i5CqDDFUBHp8Ui6ZEyhom8vG5004za7oVhJ",
      "eas": {
        "projectId": "0dae66a6-5feb-46b5-baa5-0abaab88fe12"
      }
    },
    "owner": "sukhpreetsinghv"
  }
}
