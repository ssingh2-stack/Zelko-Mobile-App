{
  "expo": {
    "name": "Clipd",
    "slug": "clipd-app",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "clipd",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.getclipd.app",
      "infoPlist": {
        "CFBundleDisplayName": "Clipd",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "buildNumber": "17"
    },
    "android": {
      "package": "ca.getclipd.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C4683E"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0dae66a6-5feb-46b5-baa5-0abaab88fe12"
      }
    },
    "owner": "sukhpreetsinghv",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0dae66a6-5feb-46b5-baa5-0abaab88fe12"
    }
  }
}
