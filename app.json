{
  "expo": {
    "name": "Zelko",
    "slug": "clipd-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": [
      "zelko",
      "clipd"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.getclipd.app",
      "infoPlist": {
        "CFBundleDisplayName": "Zelko",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "buildNumber": "19"
    },
    "android": {
      "package": "ca.getclipd.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A24C9"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A24C9"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0dae66a6-5feb-46b5-baa5-0abaab88fe12"
      },
      "apiUrl": "https://app.zelko.ca"
    },
    "owner": "sukhpreetsinghv",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0dae66a6-5feb-46b5-baa5-0abaab88fe12"
    }
  }
}
