{
  "name": "clipd-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "maestro:test": "JAVA_HOME=$HOME/.maestro/jdk/jdk-17.0.18+8/Contents/Home PATH=$JAVA_HOME/bin:$HOME/.maestro/bin:$PATH maestro test .maestro",
    "maestro:lint": "python3 -c 'import yaml, pathlib, sys; errs=0;\nfor p in sorted(pathlib.Path(\".maestro\").glob(\"*.yaml\")):\n  try:\n    docs=list(yaml.safe_load_all(p.read_text())); print(f\"OK  {p}\")\n  except Exception as e:\n    print(f\"ERR {p}: {e}\"); errs+=1\nsys.exit(errs)'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@stripe/stripe-react-native": "0.50.3",
    "expo": "^54",
    "expo-asset": "~12.0.12",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "eas-cli": "^18.7.0"
  },
  "private": true
}
